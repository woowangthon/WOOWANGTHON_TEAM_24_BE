# .env.example → .env로 복사해서 값을 넣는다. .env는 절대 커밋하지 않는다 (BE 저장소는 Public).

# 개발 중 키 없이 돌릴 땐 mock. 시연 영상·제출 배포는 반드시 live
AI_MODE=live
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# 분당 호출 상한. AI Studio에서 확인한 값으로 덮어쓸 때만 주석을 푼다
# AI_RPM=15

# 생각 수준 (생각하는 모델에서만): minimal | low | medium | high. 비우면 모델 기본값
# AI_THINKING=low

# 이미지 해상도: low | medium | high. 11/7 실험에서는 효과가 없었다
# AI_MEDIA_RESOLUTION=high

# 교차 검토(실험, scripts/try_pages.py --review)에 쓸 모델. 비우면 AI_MODEL과 같음
# AI_REVIEW_MODEL=gemini-3.5-flash-lite

# mock 모드에서 페이지당 대기 초
# AI_MOCK_DELAY=0.5
