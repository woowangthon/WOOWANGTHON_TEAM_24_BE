# Review reference for the EXISTING boinun.service only; not an installer.
# Do not create a second port-8000 service or restart merely to add --workers 1.
[Unit]
Description=Visible Lecture FastAPI and frontend
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/BE
ExecStart=/home/opc/BE/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --env-file /home/opc/BE/.env --workers 1
Restart=always
RestartSec=5
TimeoutStopSec=150
KillMode=control-group

[Install]
WantedBy=multi-user.target
